# Rust Scraper Environment Configuration
# Copy this file to .env and update values for your environment

# Logging level (trace, debug, info, warn, error)
RUST_LOG=debug

# MongoDB connection string (include database name)
MONGODB_URI=mongodb://localhost:27017/real_estayer

# Environment (development, production)
ENVIRONMENT=development

# Bind address for the HTTP server. Defaults to 127.0.0.1:3001 (localhost-only).
# Set to 0.0.0.0:3001 when the Go backend runs on another machine (or inside
# Docker) and needs to reach this scraper over the LAN.
BIND_ADDR=0.0.0.0:3001

# Chrome/Selenium Configuration for Windows
# Set HEADLESS_BROWSER=true to run without visible browser window
HEADLESS_BROWSER=false
CHROME_DRIVER_PATH=chromedriver.exe
CHROME_BINARY_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Email notification settings (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=your-email@gmail.com
