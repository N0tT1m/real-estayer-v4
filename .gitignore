.idea/
.vscode/
*.swp
*.swo
*~

# Environment variables
.env
.env.local
.env.*.local
rust-scraper/.env
# Backups and per-host variants. `.env` was ignored but `.env.bak` was not,
# so a routine `cp .env .env.bak` left a file holding a live webhook sitting
# untracked-but-committable. Ignore the whole family, keep the example.
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
/target/
rust-scraper/target/

# rustc internal compiler error dumps
rustc-ice-*.txt
**/rustc-ice-*.txt

# Logs
*.log
logs/

# Air live reload
tmp/

# ChromeDriver is fetched per-platform by rust-scraper/fetch-chromedriver.sh,
# never committed: it is a ~15MB platform-specific binary that must match the
# locally installed Chrome major version.
rust-scraper/chromedriver
rust-scraper/chromedriver.exe
rust-scraper/src/chromedriver
