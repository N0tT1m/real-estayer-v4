# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development                    # development | production
PORT=8347

# CSV of origins allowed by CORS. Must not contain "*" in production.
ALLOWED_ORIGINS=http://localhost:8347

# 32+ character random string. Generate with: openssl rand -hex 32
# If left blank in development, an ephemeral secret is generated on startup.
# Required in production — the app refuses to start otherwise.
SESSION_SECRET=

# Comma-separated list of emails that become admin on first registration.
# Leave blank in production; create the first admin via a seed script instead.
ADMIN_BOOTSTRAP_EMAILS=

# --- MongoDB ---
MONGODB_URI=mongodb://mongodb:27017/real_estayer
MONGODB_DATABASE=real_estayer

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Rust scraper ---
# Compose service name inside the docker network; override for an external host.
RUST_SCRAPER_URL=http://rust-scraper:3001
# Shared secret; the Go backend sends it as X-API-Key and the scraper refuses
# to start without it. Generate with: openssl rand -hex 32
SCRAPER_API_KEY=

# --- Flights: Duffel (primary provider, replaced Amadeus) ---
# Get a test token from https://duffel.com/join — real data in sandbox.
# Payment in test mode is handled by the Duffel test balance; flip to
# arc_bsp_cash or a card token for production.
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com

# --- Amadeus API (legacy — being decommissioned) ---
# Kept for hotels until Booking/Expedia partner contracts replace it.
# AMADEUS_ENV=test opts into the sandbox (sparse data); any value leaves
# AMADEUS_API_BASE_URL unset and uses the production host.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=                           # "test" or empty for production
AMADEUS_BASE_URL=                      # optional explicit override

# --- Outbound SMTP (used by the Rust scraper for completion emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=                                # comma-separated recipients
SMTP_IMPLICIT_TLS=false                 # true for port 465

# --- Discord (optional) ---
DISCORD_WEBHOOK_URL=

# --- Maps ---
# Optional MapTiler key. When unset the app falls back to CARTO's free Voyager
# tiles which are rate-limited and not licensed for high-traffic commercial use.
MAPTILER_KEY=

# --- Optional data-enrichment keys ---
# Ticketmaster Discovery (free tier): events strip on destination pages.
TICKETMASTER_API_KEY=
# Anthropic API key for the AI itinerary builder. Without this the feature
# 503s gracefully.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# OpenAQ v3 (free with signup) for the air-quality widget.
OPENAQ_API_KEY=
# Unsplash Access Key for destination hero images. Attribution is rendered
# automatically when set.
UNSPLASH_ACCESS_KEY=
# Outbound-link utm_source / partner tag for quick-search buttons.
AFFILIATE_TAG=realestayer

# AviationStack for live flight status (100 req/mo free tier).
AVIATIONSTACK_API_KEY=
# eBird API token for bird-sightings widget (free signup).
EBIRD_API_KEY=
# Optional: OpenFlights airports.dat URL to hydrate the in-memory directory
# with every airport on earth. Leave unset to use the ~100 top airports
# bundled at compile time.
AIRPORTS_DATA_URL=

# Booking.com Demand API (requires partner contract).
BOOKING_AFFILIATE_ID=
BOOKING_DEMAND_KEY=
# Expedia Partner Solutions (requires partner contract).
EPS_API_KEY=
EPS_SHARED_SECRET=

# Google Maps Directions key enables public-transit routing. When unset the
# app falls back to OSRM driving directions.
GOOGLE_DIRECTIONS_KEY=

# --- Car rental affiliate IDs (all optional) ---
# When unset the deep-link still renders to /cars; you just don't earn a
# commission on click. Sign-ups are partner-portal (no approval needed for
# most of these, takes minutes to get an ID).
RENTALCARS_AFFILIATE_ID=                # Booking-owned Rentalcars.com, "aid"
PRICELINE_AFFILIATE_ID=                 # Priceline Partner Network "refid"
KAYAK_AFFILIATE_ID=                     # Kayak "enc_cid"

# Public URL of this deployment — used as the base for notification email
# links. Falls back to http://localhost:<port> if empty.
APP_BASE_URL=http://localhost:8347

# --- Photo uploads ---
# Local filesystem destination for uploaded photos when S3 isn't configured.
UPLOADS_DIR=data/uploads
# S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Wasabi). Setting
# UPLOADS_S3_BUCKET opts into the S3 backend.
UPLOADS_S3_BUCKET=
UPLOADS_S3_REGION=auto
UPLOADS_S3_ENDPOINT=
UPLOADS_S3_ACCESS_KEY=
UPLOADS_S3_SECRET_KEY=
# Optional CDN / public hostname in front of the bucket.
UPLOADS_S3_PUBLIC_BASE_URL=

# --- Observability ---
# Webhook (Slack/Discord/Mattermost or any POST endpoint) that receives
# JSON on every recovered panic.
ERROR_WEBHOOK_URL=
# Expose Prometheus-format metrics at /metrics.
METRICS_ENABLED=false

# --- Encryption at rest ---
# 64-char hex (or 32 raw bytes) key used to AES-GCM encrypt passport,
# known-traveler, and loyalty numbers. Generate with: openssl rand -hex 32.
# When empty these fields are stored plain-text (dev only).
FIELD_ENCRYPTION_KEY=

# --- mongo-express (docker-compose --profile admin only) ---
MONGO_EXPRESS_USER=
MONGO_EXPRESS_PASSWORD=
