# Application
APP_ENV=development
PORT=8080

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=realestayer

# Redis
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=your-super-secret-session-key-change-me

# Amadeus API (get credentials at https://developers.amadeus.com)
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret

# Rust Scraper (runs on Windows machine with Chrome)
RUST_SCRAPER_URL=http://192.168.1.71:3001
